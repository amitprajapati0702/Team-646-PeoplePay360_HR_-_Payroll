# Database (PostgreSQL for Drizzle ORM)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=peoplepay360
POSTGRES_PORT=5432

# Drizzle ORM Connection URL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/peoplepay360

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend Microservice
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
